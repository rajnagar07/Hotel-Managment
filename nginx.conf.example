# Example Nginx server block for the Hotel Management app.
# Replace `example.com` and certificate paths before use.

upstream hotel_management_app {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name example.com www.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/example.com/chain.pem;

    client_max_body_size 16m;

    # Serve public assets directly for performance.
    location /static/ {
        alias /path/to/hotel-management/app/static/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Serve uploaded files (Excel exports / previews) directly if you keep them on disk.
    location /uploads/ {
        alias /path/to/hotel-management/uploads/;
        access_log off;
        expires 7d;
    }

    location / {
        proxy_pass http://hotel_management_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;
    }
}
