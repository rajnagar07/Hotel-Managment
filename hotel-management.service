[Unit]
Description=Hotel Management Flask app (Gunicorn)
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/var/www/hotel-management
EnvironmentFile=/var/www/hotel-management/.env
Environment="PATH=/var/www/hotel-management/venv/bin"
ExecStart=/var/www/hotel-management/venv/bin/gunicorn -c /var/www/hotel-management/gunicorn.conf.py run:app
Restart=always
RestartSec=5
KillSignal=SIGQUIT
Type=simple

[Install]
WantedBy=multi-user.target
