# Copy this file to `.env` and fill in your real values.
# Never commit the production `.env` file.

# Flask runtime mode
FLASK_ENV=production
# Optional: set to 1 only when you intentionally want debug mode.
FLASK_DEBUG=0

# Flask secret key for session signing and CSRF protection
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local PostgreSQL connection string
# Example: postgresql://hotel_user:YOUR_PASSWORD@127.0.0.1:5432/hotel_db
DATABASE_URL=postgresql://hotel_user:YOUR_PASSWORD@127.0.0.1:5432/hotel_db

# Upload and export folders used by the app
# Use persistent paths on the VPS, not temporary directories.
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports
# Public hotel media; serve this directory through Nginx as static content.
HOTEL_UPLOAD_FOLDER=app/static/uploads/hotels

# Session cookie hardening
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1

# Optional request size limit for uploads (bytes)
MAX_CONTENT_LENGTH=16777216

# Mail configuration for admin password reset emails
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Admin bootstrap values used only by setup.py
DEFAULT_ADMIN_FULL_NAME=Hotel Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
